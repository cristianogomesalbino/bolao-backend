# Copie para .env e preencha. Nunca commitar .env.

POSTGRES_USER=bolao
POSTGRES_PASSWORD=altere-aqui
POSTGRES_DB=bolao_dev

# Aponta para o serviço postgres do compose (profile dev)
DATABASE_URL=postgresql://bolao:altere-aqui@postgres:5432/bolao_dev
DIRECT_URL=postgresql://bolao:altere-aqui@postgres:5432/bolao_dev
